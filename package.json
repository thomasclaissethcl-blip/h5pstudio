{
  "name": "h5p-studio-portable",
  "productName": "H5P Studio Portable",
  "version": "0.6.2",
  "description": "Prototype isolé du widget officiel H5PEditor.Text sur socle 0.6.1 préservé",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "prepare:player": "node scripts/fetch-player.cjs",
    "build:win": "npm run prepare:editor && npm run verify:editor && npm run prepare:player && electron-builder --win --x64 --dir",
    "prepare:editor": "node scripts/prepare-editor.cjs",
    "verify:editor": "node scripts/verify-editor.cjs"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.h5pstudio.portable",
    "productName": "H5P Studio Portable",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "assets/**",
      "electron/**",
      "runtime/**",
      "package.json",
      "!**/*.md"
    ],
    "asar": true,
    "win": {
      "artifactName": "H5P-Studio-Portable-0.6.2-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "runtime-bundled/3.8.2",
        "to": "reader/3.8.2"
      }
    ]
  },
  "dependencies": {
    "jquery": "3.7.1"
  }
}
